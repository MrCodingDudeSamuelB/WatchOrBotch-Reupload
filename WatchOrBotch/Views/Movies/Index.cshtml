@model IEnumerable<WatchOrBotch.Models.Movie>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>
@if (User.IsInRole("Admin"))
{
    <p>
        <a asp-action="Create" class="btn btn-primary btn-sm"> Create </a>
    </p>
}

<table class="table">
    <thead>
        <tr>
            <th>
                @* empty header for image *@
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Title)
            </th>
            @* <th>
                @Html.DisplayNameFor(model => model.Synopsis)
            </th> *@
            <th>
                @Html.DisplayNameFor(model => model.Runtime)
            </th>
            @* <th>
                @Html.DisplayNameFor(model => model.Rating)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Genre)
            </th> *@
            <th>
                @Html.DisplayNameFor(model => model.Releasedate)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                <img src="@item.ImageUrl" alt="@item.Title" class="thumbnail"/>
            </td>
            <td>
                @Html.DisplayFor(model => item.Title)
            </td>
            @* <td>
                @Html.DisplayFor(model => item.Synopsis)
            </td> *@
            <td>
                @Html.DisplayFor(model => item.Runtime)
            </td>
            @* <td>
                @Html.DisplayFor(model => item.Rating)
            </td>
            <td>
                @Html.DisplayFor(model => item.Genre)
            </td> *@
            <td>
                @Html.DisplayFor(model => item.Releasedate)
            </td>
               <td>
                    <a asp-controller="CriticReviews"
                       asp-action="Create"
                       asp-route-movieId="@item.Id"
                       class="btn btn-primary btn-sm me-1">
                        Write Critic Review
                    </a>

                    <a asp-action="Details"
                       asp-route-id="@item.Id"
                       class="btn btn-primary btn-sm me-1">
                        Details
                    </a>

                    @if (User.IsInRole("Admin"))
                        {
                            <a asp-action="Edit"
                               asp-route-id="@item.Id"
                               class="btn btn-primary btn-sm me-1">
                                Edit
                            </a>

                            <a asp-action="Delete"
                               asp-route-id="@item.Id"
                               class="btn btn-primary btn-sm me-1">
                                Delete
                            </a>
                        }
            </td>
        </tr>
}
    </tbody>
</table>
